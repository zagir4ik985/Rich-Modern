<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>zagaDLC</AssemblyName>
    <RootNamespace>ZagaLoader</RootNamespace>
    <Version>2.0.0</Version>
    <Authors>zagaDLC</Authors>
    <Description>zagaDLC Minecraft 1.21.11 Launcher</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
    <Optimize>true</Optimize>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2739.15" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Net.Http.Json" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\loader\src\main\resources\rockstar-1.0.0.jar.encrypted" LogicalName="rockstar-1.0.0.jar.encrypted" />
    <EmbeddedResource Include="..\..\loader\src\main\resources\baritone-api-fabric-1.13.1.jar" LogicalName="baritone-api-fabric-1.13.1.jar" />
    <EmbeddedResource Include="web\index.html" LogicalName="web.index.html" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="web\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="obfuscation.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="protections.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="criticals.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
